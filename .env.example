# Optional shared inventory cache (Upstash Redis REST; server-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional dedicated inventory backend. Set these ONLY on the Vercel frontend.
# Example URL format: https://inventory.your-domain.example/api/inventory
INVENTORY_BACKEND_URL=
INVENTORY_BACKEND_TOKEN=

# Set ONLY on the dedicated backend; match INVENTORY_BACKEND_TOKEN on Vercel.
# Leave INVENTORY_BACKEND_URL empty on that backend to prevent forwarding loops.
INVENTORY_API_TOKEN=
